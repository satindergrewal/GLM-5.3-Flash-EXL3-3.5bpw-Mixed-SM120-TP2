# All knobs optional; start.sh applies these defaults. Copy to .env or export.
# Model + image
MODEL=./artifact-glm53-k35-mixed     # path to the checkpoint
IMAGE=glm53-exl3:dflash2-mixed       # built from this repo's Dockerfile
# Serve profile
PORT=8012
SERVED_NAME=GLM-5.3-Flash-EXL3-3.5bpw
CACHE=nvfp4_ds_mla                   # calibrated NVFP4 MLA KV
DCP=1                                # 2 wedges A2A on discrete pairs
PROFILE=long500k                     # single-request long-context profile
MAX_MODEL_LEN=1000000
VLLM_EXL3_PREFILL_BLOCK_M=64         # MUST be 64 or 32; 128 fails FC2 subtile
GLM53_CACHE_PATH=$HOME/.cache/glm53-exl3-k4
# start.sh behavior
WAIT=1                               # 0 = launch without health wait
